# PostgreSQL (Docker Compose uses this URL for the `db` service)
DATABASE_URL="postgresql://scheduling:scheduling@localhost:5432/scheduling"

# Public site URL — must match Microsoft Entra redirect URI base (trailing slashes are stripped at runtime)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Must be base64 that decodes to exactly 32 bytes, e.g.:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Admin UI password (min 8 characters)
ADMIN_SECRET="change-me-long-random"
# Constant meeting room URL (used in booking confirmations and calendar events)
MEETING_ROOM_URL="https://example.com/your-room"

# Microsoft Entra app (Graph delegated)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Google Calendar write integration (service account)
# Share the target calendar with GOOGLE_CLIENT_EMAIL and "Make changes to events"
GOOGLE_CLIENT_EMAIL=""
# Paste private key as a single line with \n escapes
GOOGLE_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID="primary"

# Zoom Server-to-Server OAuth (optional / currently unused in booking flow)
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
