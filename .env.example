# PostgreSQL (Docker Compose uses this URL for the `db` service)
DATABASE_URL="postgresql://scheduling:scheduling@localhost:5432/scheduling"

# Public site URL (no trailing slash) — must match Microsoft Entra redirect URI base
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# openssl rand -base64 32  OR  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Admin UI password (min 8 characters)
ADMIN_SECRET="change-me-long-random"

# Microsoft Entra app (Graph delegated)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Zoom Server-to-Server OAuth (create meeting on your account)
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
